#, python-format
msgid ""
"Set <strong>Messenger</strong> to <code>%(name)s</code>, <strong>Format</"
"strong> to Plain text, and <strong>Template</strong> to “%(template_name)s”."
msgstr ""
"Réglez <strong>Messenger</strong> sur <code>%(name)s</code>, <strong>Format</"
"strong> sur Plain text et <strong>Template</strong> sur « %(template_name)s "
"»."

